11480  expect menu-open=1
11480  expect tv=0
11480  key tap F4
11520  expect menu-open=0

# A running game owns its pad: the desktop library does not, whether or not its window is open.  Paused with the window open it
# does again.
11520  expect menu-open=0
11520  expect desk-pad=0
11520  key tap ctrl+L
11560  expect library-window=1
11560  expect desk-pad=0
