11390   expect menu-open=1
11390   pad tap b
11430   expect settings-open=0
11430   expect tv-more=0
11430   expect menu-open=1
11430   expect paused=1
11430   pad tap a                  # the focus did not move: More settings... again
11470   expect settings-open=1
11470   expect tv-more=1
11470   key tap Escape
11510  expect settings-open=0
11510  expect tv-more=0
11510  expect menu-open=1
11510  pad tap b                  # rows -> groups
11530  pad tap b                  # groups -> the menu
11570  expect menu-open=1
11570  pad tap b                  # Resume
11610  expect menu-open=0
11610  expect paused=0

# A window that is no longer "live" is never left over a running game (its pad player could not close it, and the pads are the
# game's): a Share hold closes the menu under "More settings..." (the game unpauses and polls its pad itself), and the window goes
# with the hand-off.  Same walk as above to open the window, then the hold.
11650  key tap F4
11690  expect menu-open=1
11690  pad tap dpdown
11700  pad tap dpdown
11710  pad tap dpdown
11720  pad tap dpdown
11730  pad tap dpdown
11750  pad tap a
11770  pad tap dpdown
11780  pad tap dpdown
11790  pad tap dpdown
11800  pad tap dpdown
11820  pad tap a
11840  pad tap dpdown
11850  pad tap dpdown
11860  pad tap dpdown
11870  pad tap dpdown
11880  pad tap dpdown
11890  pad tap dpdown
11910  pad tap a
11950  expect tv-more=1
11950  expect menu-open=1
11950  pad down misc1
12570  expect menu-open=0
12570  expect tv-more=0
12570  expect settings-open=0
12570  expect paused=0
12590  pad up misc1
12630  expect settings-open=0

# A game dropped on the window while it is open from the Base layer: the game starts, the window goes (no game is left behind a TV-sized
# desktop window).  Close the game from its menu (Down x9 is Close game, A asks, Up is Yes, A answers), TV mode on, Base layer to
# Settings (LB x4 clamps on Home, RB x3), into the list and Down x6 clamps on More settings... whichever row the screen remembered.
12700  key tap F4
12740  expect menu-open=1
12740  pad tap dpdown
12750  pad tap dpdown
12760  pad tap dpdown
12770  pad tap dpdown
12780  pad tap dpdown
12790  pad tap dpdown
12800  pad tap dpdown
12810  pad tap dpdown
12820  pad tap dpdown
12840  pad tap a
12860  pad tap dpup
12880  pad tap a
12920  expect loaded=0
12920  key tap F4
12960  expect tv=1
12960  pad tap leftshoulder
12970  pad tap leftshoulder
12980  pad tap leftshoulder
12990  pad tap leftshoulder
13000  pad tap rightshoulder
13010  pad tap rightshoulder
13020  pad tap rightshoulder
13040  expect tv-screen=settings
13040  pad tap dpright
13050  pad tap dpdown
13060  pad tap dpdown
13070  pad tap dpdown
13080  pad tap dpdown
13090  pad tap dpdown
13100  pad tap dpdown
13120  pad tap a
13160  expect tv-more=1
13160  load @VJ_ROMS@/yarc.j64
13220  expect loaded=1
13220  expect tv-more=0
13220  expect settings-open=0
