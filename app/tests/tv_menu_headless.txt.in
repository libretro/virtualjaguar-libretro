# A binding capture started with TV mode on keeps its input: the shoulder button that would switch sections (the screen
# the player left is Library: LB would take it to Home) and the Return key that would be Accept go to the capture instead
# of navigating.
10660  key tap F4
10700  expect tv=1
10700  expect tv-screen=library
10720  capture help
10740  pad tap leftshoulder
10780  expect tv-screen=library
10800  key tap Return
10840  expect capturing=0
10840  expect tv-screen=library
10840  expect kb-bind=help:Return
10860  key tap F4
10900  expect tv=0

# Ctrl+Shift+T (Cmd+Shift+T on a Mac) toggles TV mode with or without a game, whatever F4 is bound to; a game keeps running
# and the in-game menu stays shut.  It is ignored while a text box has the keyboard or a binding is being captured, and does
# nothing when the TV-mode setting is Off.
10920  key tap ctrl+shift+T
10960  expect tv=1
10960  expect menu-open=0
10960  key tap ctrl+shift+T
11000  expect tv=0
11000  key tap ctrl+T
11040  expect tv=0                # Ctrl alone is not the shortcut
11040  key tap shift+T
11080  expect tv=0
11080  typing on
11100  key tap ctrl+shift+T
11140  expect tv=0
11140  typing off
11140  capture help
11160  key tap ctrl+shift+T
11200  expect tv=0
11200  key tap Return             # ends the capture, if the shortcut did not already
11240  expect capturing=0
11240  tvsetting off
11260  key tap ctrl+shift+T
11300  expect tv=0
11300  tvsetting manual

# With a game loaded: the shortcut turns TV mode on and off, the game stays loaded and running, no menu opens.
11320  load @VJ_ROMS@/yarc.j64
11360  expect loaded=1
11360  key tap ctrl+shift+T
11400  expect tv=1
11400  expect loaded=1
11400  expect menu-open=0
11400  expect paused=0
11400  key tap ctrl+shift+T
11440  expect tv=0
11440  expect loaded=1
11440  expect menu-open=0
11440  expect paused=0
