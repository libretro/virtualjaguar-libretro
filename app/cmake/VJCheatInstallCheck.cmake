# Run by the cheats_install test: install into a scratch prefix and check that the
# cheats travel with their license and credit, beside the executable.
file(REMOVE_RECURSE "${PREFIX}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${PREFIX}" --config "${CONFIG}"
                RESULT_VARIABLE _rc OUTPUT_QUIET)
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "cmake --install failed (${_rc})")
endif()
file(GLOB _exe "${PREFIX}/bin/virtualjaguar*")
file(GLOB _cht "${PREFIX}/bin/cheats/*.cht")
list(LENGTH _cht _n)
foreach(_must "bin/cheats/LICENSE-libretro-database.txt" "bin/cheats/README.txt" "bin/cheats/Tempest 2000.cht")
    if(NOT EXISTS "${PREFIX}/${_must}")
        message(FATAL_ERROR "install tree is missing ${_must}")
    endif()
endforeach()
if(NOT _exe OR _n LESS 41)
    message(FATAL_ERROR "install tree incomplete: executable='${_exe}', ${_n} .cht files")
endif()
file(READ "${PREFIX}/bin/cheats/LICENSE-libretro-database.txt" _lic)
if(NOT _lic MATCHES "Attribution-ShareAlike 4.0")
    message(FATAL_ERROR "bundled license text is not CC BY-SA 4.0")
endif()
file(REMOVE_RECURSE "${PREFIX}")
message(STATUS "install tree ok: ${_n} cheat files with license and credit")
