# platform_assoc_sync: run with  cmake -DVJ_APP_DIR=<app> -DVJ_ROOT=<repo> -P VJPlatformSyncCheck.cmake
# Fails (prints "FAIL ...") when the file-type lists or the application id drift between the places that
# must agree.  See app/src/platform/commands.h (VJ_ASSOC_LIST) and app/packaging/README.md.
set(_fail 0)
function(_vj_fail msg)
    message("FAIL ${msg}")
    set(_fail 1 PARENT_SCOPE)
endfunction()

function(_vj_read out path)
    if(NOT EXISTS "${path}")
        _vj_fail("missing file ${path}")
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    file(READ "${path}" _c)
    set(${out} "${_c}" PARENT_SCOPE)
endfunction()

# Compare two lists as sets.
function(_vj_same_set what a b)
    set(_a "${a}")
    set(_b "${b}")
    list(REMOVE_DUPLICATES _a)
    list(REMOVE_DUPLICATES _b)
    list(SORT _a)
    list(SORT _b)
    if(NOT "${_a}" STREQUAL "${_b}")
        _vj_fail("${what}: [${_a}] != [${_b}]")
    endif()
endfunction()

set(_pk "${VJ_APP_DIR}/packaging")

# ---- 1. the source of truth: the C++ table ----
_vj_read(_hdr "${VJ_APP_DIR}/src/platform/commands.h")
string(REGEX MATCHALL "X\\(([a-z0-9]+), (game|disc)\\)" _x "${_hdr}")
set(_all)
set(_game)
set(_disc)
foreach(_m IN LISTS _x)
    string(REGEX REPLACE "X\\(([a-z0-9]+), (game|disc)\\)" "\\1" _e "${_m}")
    string(REGEX REPLACE "X\\(([a-z0-9]+), (game|disc)\\)" "\\2" _g "${_m}")
    list(APPEND _all ${_e})
    if(_g STREQUAL "game")
        list(APPEND _game ${_e})
    else()
        list(APPEND _disc ${_e})
    endif()
endforeach()
if(NOT _all)
    _vj_fail("could not read VJ_ASSOC_LIST from commands.h")
endif()
message(STATUS "C++ table: ${_all}")

# ---- 2. macOS Info.plist.in ----
_vj_read(_plist "${_pk}/macos/Info.plist.in")
string(REGEX MATCHALL "CFBundleTypeExtensions</key>[ \t\r\n]*<array>[^\n]*</array>" _arrays "${_plist}")
set(_plist_exts)
foreach(_a IN LISTS _arrays)
    string(REGEX MATCHALL "<string>[a-z0-9]+</string>" _s "${_a}")
    foreach(_t IN LISTS _s)
        string(REGEX REPLACE "</?string>" "" _t "${_t}")
        list(APPEND _plist_exts ${_t})
    endforeach()
endforeach()
_vj_same_set("Info.plist.in CFBundleTypeExtensions vs C++ table" "${_plist_exts}" "${_all}")
# the exported UTI's filename extensions are a subset of the document types'
string(REGEX MATCHALL "public.filename-extension</key>[ \t\r\n]*<array>[^\n]*</array>" _uti "${_plist}")
foreach(_a IN LISTS _uti)
    string(REGEX MATCHALL "<string>[a-z0-9]+</string>" _s "${_a}")
    foreach(_t IN LISTS _s)
        string(REGEX REPLACE "</?string>" "" _t "${_t}")
        if(NOT _t IN_LIST _all)
            _vj_fail("Info.plist.in UTI extension '${_t}' is not in the C++ table")
        endif()
    endforeach()
endforeach()

# ---- 3. Windows installer (one OpenWithProgids line per extension) ----
_vj_read(_iss "${_pk}/windows/virtualjaguar.iss")
string(REGEX MATCHALL "Classes\\\\\\.([a-z0-9]+)\\\\OpenWithProgids" _isx "${_iss}")
set(_iss_exts)
foreach(_m IN LISTS _isx)
    string(REGEX REPLACE "Classes\\\\\\.([a-z0-9]+)\\\\OpenWithProgids" "\\1" _e "${_m}")
    list(APPEND _iss_exts ${_e})
endforeach()
_vj_same_set("virtualjaguar.iss OpenWithProgids vs C++ table" "${_iss_exts}" "${_all}")
# ... and the Applications\virtualjaguar.exe SupportedTypes lines
# (only the SupportedTypes lines have a ValueName that is a bare ".ext")
string(REGEX MATCHALL "ValueName: \"\\.([a-z0-9]+)\"" _st "${_iss}")
set(_st_exts)
foreach(_m IN LISTS _st)
    string(REGEX REPLACE "ValueName: \"\\.([a-z0-9]+)\"" "\\1" _e "${_m}")
    list(APPEND _st_exts ${_e})
endforeach()
_vj_same_set("virtualjaguar.iss SupportedTypes vs C++ table" "${_st_exts}" "${_all}")

# ---- 4. freedesktop: shared-mime-info XML + .desktop ----
set(_id io.github.libretro.VirtualJaguar)
_vj_read(_mime "${_pk}/linux/${_id}.xml")
_vj_read(_desktop "${_pk}/linux/${_id}.desktop")
string(REGEX MATCHALL "pattern=\"\\*\\.([a-z0-9]+)\"" _g "${_mime}")
set(_mime_exts)
foreach(_m IN LISTS _g)
    string(REGEX REPLACE "pattern=\"\\*\\.([a-z0-9]+)\"" "\\1" _e "${_m}")
    list(APPEND _mime_exts ${_e})
endforeach()
_vj_same_set("${_id}.xml globs vs C++ table" "${_mime_exts}" "${_all}")
# per type: the game type holds the "game" extensions, the CD type the "disc" ones
foreach(_pair "application/x-atari-jaguar-rom|game" "application/x-atari-jaguar-cd-image|disc")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _type)
    list(GET _pair 1 _grp)
    # (cut this type's block out of the file: from its open tag to the next close tag)
    string(FIND "${_mime}" "<mime-type type=\"${_type}\">" _p0)
    if(_p0 EQUAL -1)
        _vj_fail("${_id}.xml has no ${_type}")
        continue()
    endif()
    string(SUBSTRING "${_mime}" ${_p0} -1 _tail)
    string(FIND "${_tail}" "</mime-type>" _p1)
    string(SUBSTRING "${_tail}" 0 ${_p1} _blk)
    string(REGEX MATCHALL "pattern=\"\\*\\.([a-z0-9]+)\"" _bg "${_blk}")
    set(_bexts)
    foreach(_m IN LISTS _bg)
        string(REGEX REPLACE "pattern=\"\\*\\.([a-z0-9]+)\"" "\\1" _e "${_m}")
        list(APPEND _bexts ${_e})
    endforeach()
    _vj_same_set("${_type} globs vs C++ '${_grp}' extensions" "${_bexts}" "${_${_grp}}")
endforeach()
string(REGEX MATCHALL "<mime-type type=\"([^\"]+)\"" _types "${_mime}")
set(_xml_types)
foreach(_m IN LISTS _types)
    string(REGEX REPLACE "<mime-type type=\"([^\"]+)\"" "\\1" _t "${_m}")
    list(APPEND _xml_types ${_t})
endforeach()
string(REGEX MATCH "MimeType=([^\n\r]*)" _mt "${_desktop}")
string(REGEX REPLACE "MimeType=" "" _mt "${_mt}")
set(_desk_types)
foreach(_t IN LISTS _mt)
    if(NOT "${_t}" STREQUAL "")
        list(APPEND _desk_types ${_t})
    endif()
endforeach()
_vj_same_set(".desktop MimeType= vs the XML's types" "${_desk_types}" "${_xml_types}")

# ---- 5. the core's own list: ours is a subset; the rest is the documented generic pair ----
_vj_read(_lr "${VJ_ROOT}/libretro.c")
string(REGEX MATCH "#define JAGUAR_VALID_EXTENSIONS \"([^\"]*)\"" _core "${_lr}")
string(REGEX REPLACE "#define JAGUAR_VALID_EXTENSIONS \"([^\"]*)\"" "\\1" _core "${_core}")
string(REPLACE "|" ";" _core "${_core}")
foreach(_e IN LISTS _all)
    if(NOT _e IN_LIST _core)
        _vj_fail("'${_e}' is associated but the core does not open it")
    endif()
endforeach()
set(_rest ${_core})
list(REMOVE_ITEM _rest ${_all})
# bin and prg are opened by File > Open but are too generic to claim in a file manager.
_vj_same_set("extensions the core opens but the app does not associate" "${_rest}" "bin;prg")

# ---- 6. one application id ----
_vj_read(_appcpp "${VJ_APP_DIR}/src/app.cpp")
if(NOT _appcpp MATCHES "SDL_SetAppMetadata\\(\"Virtual Jaguar\", VJ_APP_VERSION, \"${_id}\"\\)")
    _vj_fail("app.cpp SDL_SetAppMetadata identifier is not ${_id} (Wayland app_id / X11 WM_CLASS must match the .desktop file)")
endif()
if(NOT _desktop MATCHES "StartupWMClass=${_id}\n")
    _vj_fail(".desktop StartupWMClass is not ${_id}")
endif()
if(NOT _plist MATCHES "<key>CFBundleIdentifier</key><string>${_id}</string>")
    _vj_fail("Info.plist.in CFBundleIdentifier is not ${_id}")
endif()
_vj_read(_winp "${VJ_APP_DIR}/src/platform/platform_windows.cpp")
if(NOT _winp MATCHES "kAppUserModelId\\[\\] = L\"${_id}\"")
    _vj_fail("platform_windows.cpp AppUserModelID is not ${_id}")
endif()
if(NOT _iss MATCHES "AppUserModelID: \"${_id}\"")
    _vj_fail("virtualjaguar.iss shortcuts do not carry AppUserModelID ${_id}")
endif()

if(_fail)
    message(FATAL_ERROR "FAIL platform_assoc_sync")
endif()
message(STATUS "platform_assoc_sync: ${_all} agree across C++, Info.plist, installer, .desktop, mime XML; id ${_id} consistent")
