# Flatpak manifest TEMPLATE (#839).  Flathub builds have no network, so every input is a
# declared source with a SHA-256 and the app's configure-time downloads are switched to
# their offline forms (-DVJ_APP_FETCH_* / FETCHCONTENT_SOURCE_DIR_*).  The offline knobs
# for cheats/shaders/library arrive with #835/#834/#838.  Nothing here is submitted to Flathub by CI:
# see app/packaging/README.md.
app-id: io.github.libretro.VirtualJaguar
runtime: org.freedesktop.Platform
runtime-version: '25.08'
sdk: org.freedesktop.Sdk
command: virtualjaguar
finish-args:
  - --share=ipc
  - --socket=x11
  - --socket=wayland
  - --socket=pulseaudio
  - --device=all          # gamepads (hidraw / evdev) and GPU
  - --share=network       # box art and database downloads
  # Games are opened through the portal file chooser or drag and drop.
modules:
  - name: virtualjaguar
    buildsystem: cmake-ninja
    subdir: app
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DVJ_APP_BUILD_TESTS=OFF
      - -DFETCHCONTENT_SOURCE_DIR_SDL3=/run/build/virtualjaguar/third_party/SDL3
      - -DFETCHCONTENT_SOURCE_DIR_IMGUI=/run/build/virtualjaguar/third_party/imgui
      - -DVJ_APP_FETCH_CHEATS=OFF
      - -DVJ_LIBRASHADER_INCLUDE_DIR=/run/build/virtualjaguar/third_party/librashader-include
      - -DVJ_SLANG_SHADERS_ARCHIVE=/run/build/virtualjaguar/third_party/slang-shaders.tar.gz
      - -DVJ_APP_LIBRETRO_DB_DIR=/run/build/virtualjaguar/third_party/libretro-db
    sources:
      - type: git
        url: https://github.com/libretro/virtualjaguar-libretro.git
        tag: v@VERSION@
        commit: @COMMIT@
      - type: archive
        url: https://github.com/libsdl-org/SDL/releases/download/release-3.4.16/SDL3-3.4.16.tar.gz
        sha256: 7322236cd12090c3eb40b9728be4d49c76f66ad17d04369584d4ecad5cf77c68
        dest: third_party/SDL3
      - type: archive
        url: https://github.com/ocornut/imgui/archive/refs/tags/v1.92.8.tar.gz
        sha256: fecb33d33930e12ff53a34064e9d3a06c8f7c3e04408f14cd36c80e3faac863b
        dest: third_party/imgui
      - type: file
        url: https://raw.githubusercontent.com/SnowflakePowered/librashader/librashader-v0.12.0/include/librashader.h
        sha256: 5d478897c391af3f60015810b67785ae1a286d262a845485276e36ded9f21e62
        dest: third_party/librashader-include
      - type: file
        url: https://raw.githubusercontent.com/SnowflakePowered/librashader/librashader-v0.12.0/include/librashader_ld.h
        sha256: bcffcbc854afb287c9f935c1a0e3b569f5e6775ef85914bd7f7025ad1f6bde33
        dest: third_party/librashader-include
      - type: file
        url: https://github.com/libretro/slang-shaders/archive/e1d75632a205c70f14a4cc947c46d5abb7b3f7f1.tar.gz
        sha256: b8bc2fbb31a754ed41ee4ab309ece63c08123ada8e5e7c5142621461f165bbd9
        dest: third_party
        dest-filename: slang-shaders.tar.gz
      - type: file
        url: https://raw.githubusercontent.com/libretro/libretro-database/12c21cf79f1e20eff6ac68b80875816c717d0a7a/metadat/no-intro/Atari%20-%20Jaguar.dat
        sha256: 704fdf2f14e14bdae07836f2ff5600c223b38df870d81dbcd3acc0f04c846299
        dest: third_party/libretro-db
        dest-filename: Atari - Jaguar.dat
      - type: file
        url: https://raw.githubusercontent.com/libretro/libretro-database/12c21cf79f1e20eff6ac68b80875816c717d0a7a/metadat/redump/Atari%20-%20Jaguar%20CD.dat
        sha256: 6cb715e076d7a3a3e106d33c73207aa8068256533bc2b4e08eb6e1ce19d3cc8f
        dest: third_party/libretro-db
        dest-filename: Atari - Jaguar CD.dat
