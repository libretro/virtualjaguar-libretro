# The one place the from-source librashader runtime is pinned (#950).  Read by
# .github/workflows/librashader.yml (sourced) and app/cmake/VJShaders.cmake (parsed).
# KEY=VALUE only: no quotes, no expansion.
#
# librashader-v0.12.1 is the newest tag; its C headers are byte-identical to v0.12.0's
# (ABI 2, API 5), which is what app/cmake/VJShaders.cmake pins.  The archive is what GitHub
# serves for /archive/<commit>.tar.gz; the commit (not the tag object) and its SHA-256 are
# both checked.  To bump: change all three values together (git ls-remote for the commit,
# curl | shasum -a 256 for the archive).
LIBRASHADER_TAG=librashader-v0.12.1
LIBRASHADER_COMMIT=07ac790cdb9826f37cf8e1daf5011f03e3c4daa7
LIBRASHADER_SHA256=156f681b288d5ffe83b7c341bd969553b42935dfb22fd0a4610d54eab60ea536
# Stable Rust (librashader needs >= 1.88; stable is the default code path since 0.11).
# Pinned so the cache key, and the binary, do not drift with the runner image.
LIBRASHADER_RUST=1.98.1
# macOS deployment target of the dylibs; must stay <= the app's LSMinimumSystemVersion.
LIBRASHADER_MACOS_MIN=11.0
