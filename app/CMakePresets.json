{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-${presetName}"
    },
    {
      "name": "release",
      "displayName": "Release (dev channel)",
      "description": "Optimised local build: emulation thread off by default, like a release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug (dev channel)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "nightly",
      "displayName": "Release (nightly channel)",
      "description": "What the nightly builds ship: the emulation thread defaults on",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "VJ_BUILD_CHANNEL": "nightly" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "nightly", "configurePreset": "nightly", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "nightly", "configurePreset": "nightly", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
